# Production variables. NEVER fill this file in and commit it.
# CI generates the real deploy/.env on the server from the GitHub Environment "production"
# (secrets and variables with exactly these names). See deploy/README.md.

# --- Public endpoint ---
API_DOMAIN=api.kaucjapp.pl
ACME_EMAIL=you@example.com

# --- Images (set by deploy.yml) ---
IMAGE_REGISTRY=ghcr.io/isigmas/kaucjapp
IMAGE_TAG=latest-sha-goes-here

# --- Postgres ---
DB_USER=kaucjapp
DB_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Application secrets ---
JWT_SECRET=
PASSWORD_SALT=
IT_SECRET=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAIL_PASSWORD=

# --- Cloudflare R2: profile pictures (public bucket exposed on a custom domain) ---
STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_S3_BUCKET=kaucjapp-profile-pictures
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PUBLIC_BASE_URL=https://cdn.kaucjapp.pl

# --- Backups (R2 bucket, can be the same account with a different bucket) ---
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=kaucjapp-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# healthchecks.io ping URL; alerts you by e-mail when the nightly backup does not report in
BACKUP_HEALTHCHECK_URL=
