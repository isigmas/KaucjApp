# SECRET KEYS
# Key should be between 256 and 376[<384] bits (32 - 47 characters) for HS256 algorithm
JWT_SECRET=DeveloperSecretKeyForJWT123455789!
PASSWORD_SALT=DeveloperSaltForPasswordEncryption!
IT_SECRET=DevoloperSecretKeyForIT123455789!

# POSTGRES CONNECTION
DB_USER=postgres
DB_PASSWORD=password

# REDIS (optional, defaults to "devredis")
# REDIS_PASSWORD=devredis

# EMAIL CONFIGURATION
MAIL_PASSWORD=resend_api_key

# ADMIN CONFIGURATION
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
ADMIN_EMAIL=admin@exampe.com

# PROFILE PICTURES (S3-compatible dev store, started by compose as "storage")
# Address of the store as seen by the device/emulator. Physical phone on LAN: http://192.168.1.42:9090
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9090
