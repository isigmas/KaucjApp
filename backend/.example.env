# SECRET KEYS
# Key should be between 256 and 376[<384] bits (32 - 47 characters) for HS256 algorithm
JWT_SECRET=DeveloperSecretKeyForJWT123455789!
PASSWORD_SALT=DeveloperSaltForPasswordEncryption!
IT_SECRET=DevoloperSecretKeyForIT123455789!

# POSTGRES CONNECTION
DB_USER=postgres
DB_PASSWORD=password

# EMAIL CONFIGURATION
MAIL_PASSWORD=resend_api_key

# ADMIN CONFIGURATION
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
ADMIN_EMAIL=admin@exampe.com

# AZURITE / PROFILE PICTURES (users-service)
# Run Azurite locally: docker compose up azurite -d  (port 10000)
AZURE_STORAGE_USE_DEVELOPMENT_STORAGE=true
AZURE_STORAGE_DEVELOPMENT_STORAGE_PROXY_URI=http://127.0.0.1:10000
AZURE_STORAGE_CONTAINER_NAME=profile-pictures
# URL for mobile app / simulator — use your LAN IP instead of 127.0.0.1 on a physical phone
AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
AZURE_STORAGE_PUBLIC_READ_ACCESS=true

# Production Azure (example — set in CI/secrets, not Azurite):
# AZURE_STORAGE_USE_DEVELOPMENT_STORAGE=false
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=https://YOUR_ACCOUNT.blob.core.windows.net
# AZURE_STORAGE_PUBLIC_READ_ACCESS=false